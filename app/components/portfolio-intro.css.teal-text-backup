.intro-root {
  --green: #39ff14;
  --green-soft: #8cff8c;
  --green-bright: #caffca;
  --green-dim: #316d35;

  position: fixed;
  inset: 0;
  z-index: 99999;

  display: grid;
  place-items: center;

  width: 100%;
  min-height: 100vh;
  min-height: 100dvh;

  overflow: hidden;

  background:
    radial-gradient(
      circle at 50% 42%,
      rgba(57, 255, 20, 0.055),
      transparent 30%
    ),
    linear-gradient(
      180deg,
      #030604 0%,
      #050805 60%,
      #020402 100%
    );

  color: var(--green);

  animation:
    introExit 0.48s
    cubic-bezier(0.7, 0, 0.3, 1)
    6.32s forwards;
}

.intro-grid {
  position: absolute;
  inset: 0;

  opacity: 0.13;

  background-image:
    linear-gradient(
      rgba(57, 255, 20, 0.07) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(57, 255, 20, 0.07) 1px,
      transparent 1px
    );

  background-size: 54px 54px;

  animation: gridMove 8s linear infinite;
}

.intro-root::before {
  content: "";

  position: absolute;
  inset: 0;

  pointer-events: none;

  background:
    repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 3px,
      rgba(0, 0, 0, 0.12) 4px
    );

  opacity: 0.22;
}

.intro-root::after {
  content: "";

  position: absolute;
  inset: 0;

  pointer-events: none;

  box-shadow:
    inset 0 0 150px rgba(0, 0, 0, 0.72);
}

.intro-scan {
  position: absolute;
  left: 0;
  right: 0;
  top: -2px;

  height: 1px;

  background: linear-gradient(
    90deg,
    transparent,
    rgba(57, 255, 20, 0.8),
    transparent
  );

  box-shadow:
    0 0 18px rgba(57, 255, 20, 0.32);

  animation: scan 3.2s linear infinite;
}

.intro-shell {
  position: relative;
  z-index: 2;

  width: min(900px, calc(100vw - 40px));

  text-align: center;
}

.intro-system {
  display: inline-flex;
  align-items: center;
  gap: 0.55rem;

  margin-bottom: 2rem;

  color: var(--green-dim);

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.24em;

  opacity: 0;

  animation:
    fadeUp 0.45s ease
    0.05s forwards;
}

.intro-status-dot {
  width: 6px;
  height: 6px;

  border-radius: 999px;

  background: var(--green);

  box-shadow:
    0 0 12px rgba(57, 255, 20, 0.75);

  animation:
    pulse 1s ease-in-out infinite;
}

.intro-identity {
  min-height: 94px;
}

.intro-name {
  margin: 0;

  color: var(--green-bright);

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size:
    clamp(1.75rem, 5vw, 4rem);

  font-weight: 650;

  letter-spacing: -0.045em;

  line-height: 1.05;

  text-shadow:
    0 0 8px rgba(57, 255, 20, 0.12),
    0 0 35px rgba(57, 255, 20, 0.055);
}

.intro-cursor {
  color: var(--green);

  animation:
    cursorBlink 0.72s steps(1) infinite;
}

.intro-role {
  margin: 0.85rem 0 0;

  color: var(--green-soft);

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size:
    clamp(0.72rem, 1.5vw, 0.95rem);

  font-weight: 600;

  letter-spacing: 0.22em;

  text-transform: uppercase;

  opacity: 0;

  transform: translateY(8px);

  animation:
    roleReveal 0.55s ease
    0.88s forwards;
}

.intro-divider {
  width: 100%;
  height: 1px;

  margin: 1.65rem 0 1.45rem;

  overflow: hidden;

  background:
    rgba(57, 255, 20, 0.08);
}

.intro-divider span {
  display: block;

  width: 100%;
  height: 100%;

  background: linear-gradient(
    90deg,
    transparent,
    var(--green),
    transparent
  );

  transform: translateX(-100%);

  animation:
    dividerSweep 1.45s ease
    0.95s forwards;
}

.intro-pipeline {
  position: relative;

  display: grid;
  grid-template-columns:
    repeat(5, minmax(0, 1fr));

  gap: 0.35rem;

  margin: 0 auto;

  max-width: 740px;

  opacity: 0;

  animation:
    fadeUp 0.35s ease
    1.1s forwards;
}

.intro-pipeline-line {
  position: absolute;

  left: 7%;
  right: 7%;
  top: 13px;

  height: 1px;

  background:
    rgba(57, 255, 20, 0.14);
}

.intro-pipeline-line::after {
  content: "";

  position: absolute;
  inset: 0;

  transform: scaleX(0);
  transform-origin: left;

  background:
    linear-gradient(
      90deg,
      var(--green),
      #00ff88
    );

  box-shadow:
    0 0 10px
    rgba(57, 255, 20, 0.35);

  animation:
    pipelineFlow 2.1s ease
    1.25s forwards;
}

.intro-step {
  position: relative;
  z-index: 2;

  display: flex;
  flex-direction: column;
  align-items: center;

  gap: 0.55rem;
}

.intro-step-node {
  display: grid;
  place-items: center;

  width: 27px;
  height: 27px;

  border: 1px solid
    rgba(57, 255, 20, 0.24);

  border-radius: 999px;

  background: #050905;

  color: #4b874f;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    monospace;

  font-size: 0.5rem;
  font-weight: 700;

  animation:
    nodeOnline 0.36s ease forwards;

  animation-delay:
    calc(
      1.25s +
      (var(--step) * 0.42s)
    );
}

.intro-step-label {
  color: #47764b;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    monospace;

  font-size:
    clamp(0.46rem, 1.1vw, 0.58rem);

  font-weight: 700;

  letter-spacing: 0.11em;

  text-transform: uppercase;

  animation:
    labelOnline 0.36s ease forwards;

  animation-delay:
    calc(
      1.25s +
      (var(--step) * 0.42s)
    );
}

.intro-terminal {
  width: min(620px, 100%);

  margin:
    1.45rem auto 0;

  text-align: left;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size:
    clamp(0.6rem, 1.25vw, 0.72rem);

  line-height: 1.65;
}

.intro-terminal-line {
  margin: 0;

  color: #58965d;

  opacity: 0;

  transform: translateY(4px);
}

.intro-terminal-line span {
  color: var(--green);

  text-shadow:
    0 0 9px
    rgba(57, 255, 20, 0.35);
}

.intro-terminal-1 {
  animation:
    terminalLine 0.3s ease
    1.3s forwards;
}

.intro-terminal-2 {
  animation:
    terminalLine 0.3s ease
    1.76s forwards;
}

.intro-terminal-3 {
  animation:
    terminalLine 0.3s ease
    2.22s forwards;
}

.intro-terminal-4 {
  animation:
    terminalLine 0.3s ease
    2.68s forwards;
}

.intro-stoic {
  position: relative;

  height: 38px;

  margin-top: 1.15rem;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    monospace;
}

.intro-stoic span {
  position: absolute;

  left: 0;
  right: 0;

  color: var(--green-bright);

  font-size:
    clamp(0.72rem, 1.6vw, 0.9rem);

  font-weight: 750;

  letter-spacing: 0.2em;

  opacity: 0;

  text-shadow:
    0 0 14px
    rgba(57, 255, 20, 0.14);
}

.intro-stoic-1 {
  animation:
    stoicLine 0.95s ease
    1.45s forwards;
}

.intro-stoic-2 {
  animation:
    stoicLine 0.95s ease
    2.38s forwards;
}

.intro-stoic-3 {
  animation:
    stoicLineFinal 1.05s ease
    3.28s forwards;
}

.intro-story {
  width: min(640px, 100%);

  min-height: 64px;

  margin:
    0.45rem auto 0;

  text-align: center;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size:
    clamp(0.56rem, 1.2vw, 0.7rem);

  font-weight: 550;

  line-height: 1.65;

  letter-spacing: 0.055em;

  color: #56865b;
}

.intro-story span {
  display: block;

  opacity: 0;

  transform:
    translateY(5px);

  text-shadow:
    0 0 10px
    rgba(57, 255, 20, 0.035);
}

.intro-story-1 {
  animation:
    storyReveal 0.48s ease
    4.05s forwards;
}

.intro-story-2 {
  animation:
    storyReveal 0.48s ease
    4.52s forwards;
}

.intro-story-3 {
  color: #8cff8c;

  animation:
    storyReveal 0.5s ease
    5.02s forwards;

  text-shadow:
    0 0 12px
    rgba(57, 255, 20, 0.08) !important;
}

.intro-stack {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;

  gap: 0.65rem;

  margin-top: 0.7rem;

  color: #315d35;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    monospace;

  font-size: 0.46rem;
  font-weight: 700;

  letter-spacing: 0.16em;

  opacity: 0;

  animation:
    fadeUp 0.45s ease
    5.68s forwards;
}

.intro-stack i {
  width: 3px;
  height: 3px;

  border-radius: 999px;

  background: var(--green);
}

@keyframes storyReveal {
  from {
    opacity: 0;
    transform: translateY(5px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes fadeUp {
  from {
    opacity: 0;
    transform: translateY(8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes roleReveal {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes cursorBlink {
  0%,
  45% {
    opacity: 1;
  }

  46%,
  100% {
    opacity: 0;
  }
}

@keyframes dividerSweep {
  to {
    transform: translateX(100%);
  }
}

@keyframes pipelineFlow {
  0% {
    transform: scaleX(0);
  }

  100% {
    transform: scaleX(1);
  }
}

@keyframes nodeOnline {
  to {
    color: var(--green-bright);

    border-color:
      rgba(57, 255, 20, 0.62);

    background:
      rgba(57, 255, 20, 0.065);

    box-shadow:
      0 0 15px
      rgba(57, 255, 20, 0.15);
  }
}

@keyframes labelOnline {
  to {
    color: var(--green-soft);
  }
}

@keyframes terminalLine {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes stoicLine {
  0% {
    opacity: 0;
    transform: translateY(6px);
  }

  20%,
  68% {
    opacity: 1;
    transform: translateY(0);
  }

  100% {
    opacity: 0;
    transform: translateY(-5px);
  }
}

@keyframes stoicLineFinal {
  0% {
    opacity: 0;
    transform: translateY(6px);
  }

  20%,
  78% {
    opacity: 1;
    transform: translateY(0);
  }

  100% {
    opacity: 0;
  }
}

@keyframes pulse {
  0%,
  100% {
    opacity: 0.45;
    transform: scale(0.9);
  }

  50% {
    opacity: 1;
    transform: scale(1.28);
  }
}

@keyframes scan {
  from {
    transform:
      translateY(-5vh);
    opacity: 0;
  }

  12% {
    opacity: 0.55;
  }

  88% {
    opacity: 0.12;
  }

  to {
    transform:
      translateY(105vh);
    opacity: 0;
  }
}

@keyframes gridMove {
  from {
    background-position: 0 0;
  }

  to {
    background-position:
      54px 54px;
  }
}

@keyframes introExit {
  from {
    opacity: 1;
    transform: scale(1);
  }

  to {
    opacity: 0;
    transform: scale(1.012);
    visibility: hidden;
  }
}

@media (max-width: 640px) {
  .intro-shell {
    width:
      min(
        92vw,
        560px
      );
  }

  .intro-system {
    margin-bottom: 1.55rem;

    font-size: 0.5rem;
  }

  .intro-name {
    font-size:
      clamp(
        1.45rem,
        8vw,
        2.15rem
      );
  }

  .intro-role {
    font-size: 0.58rem;
    letter-spacing: 0.16em;
  }

  .intro-divider {
    margin:
      1.3rem 0 1.15rem;
  }

  .intro-step-label {
    font-size: 0.42rem;
    letter-spacing: 0.04em;
  }

  .intro-step-node {
    width: 24px;
    height: 24px;
  }

  .intro-terminal {
    margin-top: 1.2rem;

    font-size: 0.56rem;
  }

  .intro-stoic span {
    font-size: 0.65rem;
    letter-spacing: 0.13em;
  }

  .intro-story {
    min-height: 68px;

    margin-top: 0.35rem;

    padding: 0 0.4rem;

    font-size: 0.5rem;

    line-height: 1.7;

    letter-spacing: 0.025em;
  }

  .intro-stack {
    gap: 0.42rem;

    font-size: 0.39rem;

    letter-spacing: 0.08em;
  }
}

@media (
  prefers-reduced-motion: reduce
) {
  .intro-root,
  .intro-root *,
  .intro-root *::before,
  .intro-root *::after {
    animation-duration:
      0.01ms !important;

    animation-delay:
      0ms !important;
  }
}

/* -------------------------------------------------------
   INTRO SOUND CONTROL
------------------------------------------------------- */

.intro-sound-toggle {
  position: fixed;
  z-index: 100001;

  top: max(1rem, env(safe-area-inset-top));
  right: max(1rem, env(safe-area-inset-right));

  display: inline-flex;
  align-items: center;
  gap: 0.48rem;

  padding: 0.52rem 0.7rem;

  border: 1px solid rgba(57, 255, 20, 0.22);
  border-radius: 999px;

  background: rgba(3, 7, 4, 0.74);

  color: #70b975;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 0.5rem;
  font-weight: 700;

  letter-spacing: 0.14em;

  backdrop-filter: blur(12px);

  cursor: pointer;

  transition:
    color 0.2s ease,
    border-color 0.2s ease,
    background-color 0.2s ease;
}

.intro-sound-toggle:hover {
  color: #baffba;

  border-color: rgba(57, 255, 20, 0.48);

  background: rgba(57, 255, 20, 0.055);
}

.intro-sound-dot {
  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: #355b38;
}

.intro-sound-dot.is-on {
  background: #39ff14;

  box-shadow:
    0 0 6px rgba(57, 255, 20, 0.9),
    0 0 12px rgba(57, 255, 20, 0.42);
}

@media (max-width: 640px) {
  .intro-sound-toggle {
    top: max(0.7rem, env(safe-area-inset-top));
    right: max(0.7rem, env(safe-area-inset-right));

    padding: 0.45rem 0.58rem;

    font-size: 0.43rem;
  }
}


/* =========================================================
   STOIC STORY — RETRO OPERATIONS TERMINAL
========================================================= */

.intro-story-computer {
  display: flex;
  justify-content: center;
  width: 100%;
  margin: 0.35rem auto 0;
  perspective: 900px;
}

.intro-monitor {
  position: relative;
  width: min(640px, 78vw);

  opacity: 0;
  transform: translateY(10px) scale(0.975);

  animation:
    introMonitorEnter
    0.52s ease
    3.92s forwards;
}

.intro-monitor-bezel {
  position: relative;

  padding: 7px;

  overflow: hidden;

  border: 1px solid rgba(57, 255, 20, 0.22);

  border-radius: 15px 15px 12px 12px;

  background:
    linear-gradient(
      145deg,
      #151b17,
      #070b08 60%,
      #111813
    );

  box-shadow:
    inset 0 0 0 1px rgba(255, 255, 255, 0.025),
    inset 0 -8px 20px rgba(0, 0, 0, 0.5),
    0 15px 45px rgba(0, 0, 0, 0.48),
    0 0 22px rgba(57, 255, 20, 0.045);
}

.intro-monitor-bar {
  display: flex;
  align-items: center;

  min-height: 27px;

  padding: 0 0.55rem;

  border: 1px solid rgba(57, 255, 20, 0.08);
  border-bottom: 0;

  border-radius: 8px 8px 0 0;

  background:
    linear-gradient(
      180deg,
      rgba(20, 29, 22, 0.95),
      rgba(8, 14, 10, 0.98)
    );

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;
}

.intro-monitor-lights {
  display: flex;
  gap: 4px;
}

.intro-monitor-lights span {
  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: rgba(140, 255, 140, 0.25);
}

.intro-monitor-lights span:first-child {
  background: #39ff14;

  box-shadow:
    0 0 6px rgba(57, 255, 20, 0.65);
}

.intro-monitor-title {
  margin-left: 0.62rem;

  color: #48754d;

  font-size: 0.46rem;
  font-weight: 700;

  letter-spacing: 0.18em;
}

.intro-monitor-live {
  margin-left: auto;

  color: #72d77a;

  font-size: 0.43rem;
  font-weight: 700;

  letter-spacing: 0.14em;
}

.intro-monitor-screen {
  position: relative;

  display: grid;
  place-items: center;

  min-height: 128px;

  overflow: hidden;

  padding: 1.1rem 1.3rem;

  border: 1px solid rgba(57, 255, 20, 0.15);

  border-radius: 2px 2px 8px 8px;

  background:
    radial-gradient(
      ellipse at center,
      rgba(57, 255, 20, 0.055),
      transparent 61%
    ),
    linear-gradient(
      180deg,
      #020804,
      #010503
    );

  box-shadow:
    inset 0 0 45px rgba(0, 0, 0, 0.85),
    inset 0 0 18px rgba(57, 255, 20, 0.035);
}

.intro-monitor-screen::before {
  content: "";

  position: absolute;
  inset: 7px 8px;

  pointer-events: none;

  border: 1px solid rgba(57, 255, 20, 0.045);

  border-radius: 45% / 8%;

  box-shadow:
    inset 0 0 22px rgba(0, 0, 0, 0.6);
}

.intro-monitor-glow {
  position: absolute;
  inset: 0;

  pointer-events: none;

  background:
    radial-gradient(
      ellipse at center,
      rgba(57, 255, 20, 0.07),
      transparent 54%
    );

  animation:
    introMonitorGlow
    1.7s ease-in-out
    infinite alternate;
}

.intro-monitor-scanlines {
  position: absolute;
  inset: 0;

  z-index: 3;

  pointer-events: none;

  opacity: 0.16;

  background:
    repeating-linear-gradient(
      to bottom,
      rgba(190, 255, 190, 0.08) 0,
      rgba(190, 255, 190, 0.08) 1px,
      transparent 1px,
      transparent 4px
    );
}

.intro-monitor-copy {
  position: relative;

  z-index: 2;

  text-align: center;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;
}

.intro-monitor-copy p {
  margin: 0;

  color: #548c59;

  font-size:
    clamp(0.58rem, 1vw, 0.72rem);

  font-weight: 600;

  line-height: 1.7;

  letter-spacing: 0.055em;

  opacity: 0;

  transform: translateY(5px);

  text-shadow:
    0 0 8px rgba(57, 255, 20, 0.08);
}

.intro-monitor-copy .intro-story-1 {
  animation:
    storyReveal
    0.48s ease
    4.05s forwards;
}

.intro-monitor-copy .intro-story-2 {
  animation:
    storyReveal
    0.48s ease
    4.52s forwards;
}

.intro-monitor-copy .intro-story-3 {
  color: #8cff8c;

  font-weight: 750;

  text-shadow:
    0 0 9px rgba(57, 255, 20, 0.17);

  animation:
    storyReveal
    0.5s ease
    5.02s forwards;
}

.intro-monitor-cursor {
  position: absolute;

  z-index: 4;

  right: 13px;
  bottom: 9px;

  color: #39ff14;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    monospace;

  font-size: 0.7rem;

  text-shadow:
    0 0 7px rgba(57, 255, 20, 0.5);

  animation:
    cursorBlink
    0.75s steps(1)
    infinite;
}

.intro-monitor-controls {
  display: flex;
  align-items: center;

  min-height: 25px;

  padding: 0 0.6rem;

  color: #3c6941;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    monospace;

  font-size: 0.38rem;
  font-weight: 700;

  letter-spacing: 0.14em;
}

.intro-monitor-controls > div {
  display: flex;

  gap: 5px;

  margin: 0 auto;
}

.intro-monitor-controls i {
  display: block;

  width: 4px;
  height: 4px;

  border-radius: 50%;

  background: #1c4521;
}

.intro-monitor-controls i:nth-child(2) {
  background: #39ff14;

  box-shadow:
    0 0 5px rgba(57, 255, 20, 0.55);
}

.intro-monitor-controls strong {
  color: #4e8454;

  font-size: inherit;
}

.intro-monitor-neck {
  width: 16%;
  height: 12px;

  margin: 0 auto;

  border-left: 1px solid rgba(57, 255, 20, 0.11);
  border-right: 1px solid rgba(57, 255, 20, 0.11);

  background:
    linear-gradient(
      90deg,
      #080d09,
      #151d17,
      #080d09
    );
}

.intro-monitor-base {
  width: 29%;
  height: 5px;

  margin: 0 auto;

  border: 1px solid rgba(57, 255, 20, 0.11);

  border-radius: 50% 50% 3px 3px;

  background:
    linear-gradient(
      180deg,
      #182119,
      #050805
    );

  box-shadow:
    0 7px 18px rgba(0, 0, 0, 0.32);
}

@keyframes introMonitorEnter {
  from {
    opacity: 0;

    transform:
      translateY(10px)
      scale(0.975);
  }

  to {
    opacity: 1;

    transform:
      translateY(0)
      scale(1);
  }
}

@keyframes introMonitorGlow {
  from {
    opacity: 0.4;
  }

  to {
    opacity: 0.9;
  }
}

@media (max-width: 640px) {
  .intro-story-computer {
    margin-top: 0.25rem;
  }

  .intro-monitor {
    width: min(350px, 91vw);
  }

  .intro-monitor-bezel {
    padding: 5px;

    border-radius:
      11px 11px 9px 9px;
  }

  .intro-monitor-bar {
    min-height: 22px;

    padding: 0 0.42rem;
  }

  .intro-monitor-title {
    font-size: 0.36rem;

    letter-spacing: 0.12em;
  }

  .intro-monitor-live {
    font-size: 0.34rem;
  }

  .intro-monitor-lights span {
    width: 4px;
    height: 4px;
  }

  .intro-monitor-screen {
    min-height: 104px;

    padding: 0.8rem 0.75rem;
  }

  .intro-monitor-copy p {
    font-size: 0.49rem;

    line-height: 1.65;

    letter-spacing: 0.025em;
  }

  .intro-monitor-controls {
    min-height: 20px;

    padding: 0 0.45rem;

    font-size: 0.3rem;
  }

  .intro-monitor-neck {
    height: 9px;
  }

  .intro-monitor-base {
    height: 4px;
  }
}
